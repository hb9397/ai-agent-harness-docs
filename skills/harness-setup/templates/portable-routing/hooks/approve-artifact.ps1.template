[CmdletBinding()]
param(
    [Parameter(Mandatory)]
    [string]$ArtifactPath,
    [switch]$Plan
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

if (-not $Plan) {
    throw 'Approval markers are not written in B1. Use -Plan until the approval workflow is approved.'
}

[ordered]@{
    schema_version = '1.0.0'
    action = 'approval-marker-proposal'
    artifact_path = $ArtifactPath
    writes = @()
    status = 'pending-approval-workflow'
} | ConvertTo-Json -Depth 3
