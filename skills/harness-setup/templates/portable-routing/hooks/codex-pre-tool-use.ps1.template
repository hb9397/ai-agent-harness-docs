[CmdletBinding()]
param()

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$raw = [Console]::In.ReadToEnd()
if ([string]::IsNullOrWhiteSpace($raw)) {
    Write-Error 'Codex PreToolUse payload is required.'
    exit 2
}

$payload = $raw | ConvertFrom-Json
if ([string]::IsNullOrWhiteSpace([string]$payload.tool_name) -or $null -eq $payload.tool_input) {
    Write-Error 'Codex PreToolUse requires tool_name and tool_input.'
    exit 2
}
if (($payload.tool_name -in @('Bash', 'apply_patch')) -and [string]::IsNullOrWhiteSpace([string]$payload.tool_input.command)) {
    Write-Error 'Codex Bash and apply_patch require tool_input.command.'
    exit 2
}

$projectRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\\..')).Path
$corePath = Join-Path $projectRoot '.ai-docs/harness/hooks/artifact-route-core.ps1'
try {
    $decision = (& $corePath -RuntimeHost codex -ProjectRoot $projectRoot -ToolName $payload.tool_name -ToolInput $payload.tool_input | ConvertFrom-Json)
} catch {
    [ordered]@{ hookSpecificOutput = [ordered]@{ permissionDecision = 'deny'; permissionDecisionReason = "Codex routing guard failed: $($_.Exception.Message)" } } | ConvertTo-Json -Depth 8 -Compress
    exit 2
}
if ($decision.decision -eq 'deny') {
    [ordered]@{ hookSpecificOutput = [ordered]@{ permissionDecision = 'deny'; permissionDecisionReason = [string]$decision.reason } } | ConvertTo-Json -Depth 8 -Compress
    exit 0
}
$decision | ConvertTo-Json -Depth 8 -Compress
exit 0
