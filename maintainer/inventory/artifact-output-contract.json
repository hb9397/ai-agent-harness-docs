{
  "schema_version": "1.0.0",
  "purpose": "Canonical single-app and multi-app artifact ownership and output routing for every current user and manager skill.",
  "instruction": {
    "name": "artifact-output-routing-instruction.md",
    "single_app_path": ".docs/instruction/artifact-output-routing-instruction.md",
    "multi_app_path": ".docs/{앱}/instruction/artifact-output-routing-instruction.md",
    "single_app_ref": "@.docs/instruction/artifact-output-routing-instruction.md",
    "multi_app_ref": "@.docs/{앱}/instruction/artifact-output-routing-instruction.md"
  },
  "discovery": {
    "user_root": "skills/*/SKILL.md",
    "manager_root": "maintainer/skills/*/SKILL.md",
    "expected_user_skill_count": 19,
    "expected_manager_skill_count": 3,
    "unknown_write_capability_is_failure": true,
    "scope_boundary": "manager skills never write user .docs and user skills never write manager maintainer/"
  },
  "artifact_classes": [
    "managed-project-output",
    "source-mutation",
    "report-only",
    "chat-only",
    "manager-repository-output"
  ],
  "routing_profiles": {
    "source-mutation": {
      "media_type": "repository source, configuration, or Git metadata",
      "required_format": "preserve the selected repository's existing format and owner conventions",
      "unknown_write_capability": false
    },
    "managed-markdown": {
      "media_type": "Markdown document",
      "required_format": "canonical .docs path and the project artifact-format-contract.json",
      "unknown_write_capability": false
    },
    "prototype-bundle": {
      "media_type": "HTML/CSS/JS and Markdown prototype bundle",
      "required_format": "canonical .docs prototype path and the project artifact-format-contract.json",
      "unknown_write_capability": false
    },
    "chat-report": {
      "media_type": "chat Markdown report",
      "required_format": "no persistent file unless the user selects a path",
      "unknown_write_capability": false
    },
    "manager-repository": {
      "media_type": "manager repository Markdown, JSON, scripts, or release archive",
      "required_format": "maintainer/** or plugins/** only; never a user project .docs path",
      "unknown_write_capability": false
    }
  },
  "portable_routing_baseline": {
    "status": "baseline-captured",
    "scope": "Track B Phase B0 read-only host capability and topology evidence; this baseline neither installs hooks nor modifies an external project.",
    "case_study_fixture": "skills/harness-setup/evals/fixtures/portable-routing-baseline.json",
    "common_policy_location": ".docs/harness/**",
    "host_specific_installation": {
      "claude": ".claude/settings.json; .claude/hooks/**",
      "codex": ".codex/hooks.json; .codex/hooks/**"
    },
    "host_capabilities": {
      "claude": {
        "status": "supported",
        "event": "PreToolUse",
        "matcher": "Write|Edit",
        "input": "JSON stdin; tool_name and tool_input",
        "deny": "exit code 2 with stderr or a documented decision response",
        "project_scope": ".claude/settings.json",
        "project_root_variable": "CLAUDE_PROJECT_DIR",
        "source": "https://code.claude.com/docs/en/hooks"
      },
      "codex": {
        "status": "supported",
        "event": "PreToolUse",
        "matcher": "apply_patch, Edit|Write, Bash, MCP or other local-function tool name",
        "input": "JSON stdin; Bash and apply_patch use tool_input.command",
        "deny": "exit code 2 with stderr or hookSpecificOutput.permissionDecision=deny",
        "project_scope": ".codex/hooks.json",
        "trust": "new or changed non-managed hook definitions remain pending review until trusted through /hooks",
        "source": "https://learn.chatgpt.com/docs/hooks"
      }
    },
    "bypass_boundaries": [
      "hosted tools and remote services outside the local hook path",
      "specialized tool paths that opt out of the default hook path",
      "shell-internal dynamic paths after an allowed command has started",
      "external processes and writes outside the project root"
    ],
    "reuse_decision": "extend artifact-output-contract and harness-setup eval; reuse existing setup/bootstrap/context templates and the read-only Claude case; create Codex adapter and portable bundle only in later approved phases."
  },
  "portable_routing_bundle": {
    "status": "phase-b1-defined",
    "scope": "A project-owned, plugin-neutral bundle definition. It defines schemas, adapters and a no-write planning installer; it does not install host hooks or activate trust.",
    "template_root": "skills/harness-setup/templates/portable-routing",
    "shared_bundle_root": ".docs/harness",
    "single_app_instruction": ".docs/instruction/artifact-output-routing-instruction.md",
    "multi_app_instruction": ".docs/{app}/instruction/artifact-output-routing-instruction.md",
    "project_owned_outputs": [
      "AGENTS.md",
      "CLAUDE.md",
      ".docs/harness/artifact-routing.json",
      ".docs/harness/artifact-format-contract.json",
      ".docs/harness/README.md",
      ".docs/harness/install-routing.ps1",
      ".docs/harness/hooks/artifact-route-core.ps1",
      ".docs/harness/hooks/claude-pre-tool-use.ps1",
      ".docs/harness/hooks/codex-pre-tool-use.ps1",
      ".docs/harness/hooks/approve-artifact.ps1",
      ".claude/settings.json",
      ".claude/hooks/claude-pre-tool-use.ps1",
      ".codex/hooks.json",
      ".codex/hooks/codex-pre-tool-use.ps1"
    ],
    "host_adapters": {
      "claude": {
        "config": ".claude/settings.json",
        "adapter": ".claude/hooks/claude-pre-tool-use.ps1",
        "input_contract": "PreToolUse JSON stdin with tool_name and tool_input; project root from CLAUDE_PROJECT_DIR",
        "merge_rule": "merge only the managed PreToolUse entry; preserve unrelated settings"
      },
      "codex": {
        "config": ".codex/hooks.json",
        "adapter": ".codex/hooks/codex-pre-tool-use.ps1",
        "input_contract": "PreToolUse JSON stdin; Bash and apply_patch inspect tool_input.command",
        "merge_rule": "merge only the managed hooks.json entry; never add inline [hooks] to .codex/config.toml"
      }
    },
    "installation": {
      "plan_command": ".docs/harness/install-routing.ps1 -Plan",
      "absolute_path_rule": "Render the absolute project root and Codex hook command only in installed project files. Templates and shared bundle sources contain no user-specific absolute path.",
      "trust_state_before_g13": "pending-trust",
      "gates": {
        "G10": "required before writing host-local hook files or merging host config",
        "G13": "required before Claude hook activation or Codex /hooks trust"
      }
    }
  },
