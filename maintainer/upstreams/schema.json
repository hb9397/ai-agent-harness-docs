{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-agent-harness/upstream-registry.schema.json",
  "title": "AI Agent Harness Upstream Registry",
  "type": "object",
  "required": ["schema_version", "generated_at", "governance", "behavior_contracts", "sources"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.1\\.0$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "behavior_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior_contract"
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "governance": {
      "type": "object",
      "required": ["canonical_document", "required_anchors"],
      "properties": {
        "canonical_document": {
          "type": "string"
        },
        "required_anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "watched_surface": {
      "type": "object",
      "required": ["id", "kind", "url", "change_signals"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": ["repository-path", "documentation", "changelog", "specification"]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "path": {
          "type": ["string", "null"]
        },
        "change_signals": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      }
    },
    "source_refresh_policy": {
      "type": "object",
      "required": [
        "strategy",
        "auto_import",
        "review_on_change",
        "stale_after_days",
        "stale_fallback",
        "observed_ref",
        "observed_product_version"
      ],
      "properties": {
        "strategy": {
          "enum": ["observe-and-review"]
        },
        "auto_import": {
          "const": false
        },
        "review_on_change": {
          "const": true
        },
        "stale_after_days": {
          "type": "integer",
          "minimum": 1
        },
        "stale_fallback": {
          "enum": ["preserve-last-accepted-mark-stale"]
        },
        "observed_ref": {
          "type": "string"
        },
        "observed_product_version": {
          "type": ["string", "null"]
        }
      }
    },
    "behavior_claim": {
      "type": "object",
      "required": ["id", "claim_class", "summary", "source_ids"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "claim_class": {
          "enum": ["official-documented", "local-policy", "runtime-observation"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "observation_kind": {
          "enum": ["product-version", "fixture-result"]
        }
      }
    },
    "runtime_fixture": {
      "type": "object",
      "required": ["id", "status", "platforms", "evidence_path", "claim_scope"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "status": {
          "enum": ["planned", "observed"]
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": ["codex", "claude-code"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_path": {
          "type": ["string", "null"]
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unsupported_guarantee": {
      "type": "object",
      "required": ["id", "status", "summary"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "status": {
          "const": "unsupported"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "behavior_contract": {
      "type": "object",
      "required": [
        "id",
        "lifecycle",
        "consumers",
        "claims",
        "unsupported_guarantees",
        "refresh_policy",
        "validation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "lifecycle": {
          "enum": ["candidate", "active", "blocked", "deprecated"]
        },
        "consumers": {
          "type": "object",
          "required": ["skills", "docs", "validators"],
          "properties": {
            "skills": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1,
              "uniqueItems": true
            },
            "docs": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1,
              "uniqueItems": true
            },
            "validators": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/behavior_claim"},
          "minItems": 3
        },
        "unsupported_guarantees": {
          "type": "array",
          "items": {"$ref": "#/$defs/unsupported_guarantee"},
          "minItems": 1
        },
        "refresh_policy": {
          "type": "object",
          "required": ["strategy", "auto_import", "review_triggers", "stale_fallback"],
          "properties": {
            "strategy": {"const": "manual-semantic-review"},
            "auto_import": {"const": false},
            "review_triggers": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "stale_fallback": {"const": "preserve-last-accepted-mark-stale"}
          }
        },
        "validation": {
          "type": "object",
          "required": ["static_evals", "runtime_fixtures"],
          "properties": {
            "static_evals": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "runtime_fixtures": {
              "type": "array",
              "items": {"$ref": "#/$defs/runtime_fixture"},
              "minItems": 1
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "source_class",
        "integration_mode",
        "lifecycle",
        "upstream",
        "target",
        "policy",
        "provenance",
        "protection",
        "validation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_class": {
          "enum": ["internal", "official", "reputable-third-party", "community", "standard", "unknown"]
        },
        "integration_mode": {
          "enum": ["native", "reference", "vendored", "adapted", "unknown"]
        },
        "intended_integration_mode": {
          "enum": ["native", "reference", "vendored", "adapted", "unknown"]
        },
        "relationship_group": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Groups multiple integration relationships that derive from one upstream repository. Sources sharing a group must agree on repository URL, license determination and pinned commit, and must be approved and promoted together."
        },
        "lifecycle": {
          "enum": ["candidate", "active", "blocked", "deprecated"]
        },
        "refresh_policy": {
          "$ref": "#/$defs/source_refresh_policy"
        },
        "upstream": {
          "type": "object",
          "required": ["kind", "source_url", "tracking"],
          "properties": {
            "kind": {
              "enum": ["repository", "documentation", "specification", "local"]
            },
            "source_url": {
              "type": "string"
            },
            "repository": {
              "type": ["string", "null"]
            },
            "tracking": {
              "enum": ["release", "tag", "branch", "documentation", "manual", "none"]
            },
            "branch": {
              "type": ["string", "null"]
            },
            "tag_pattern": {
              "type": ["string", "null"]
            },
            "allow_prerelease": {
              "type": "boolean"
            },
            "watched_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "watched_surfaces": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/watched_surface"
              },
              "uniqueItems": true
            }
          }
        },
        "target": {
          "type": "object",
          "required": ["local_skills", "platform_targets"],
          "properties": {
            "local_skills": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "behavior_contracts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "uniqueItems": true
            },
            "platform_targets": {
              "type": "array",
              "items": {
                "enum": ["codex", "claude-code", "claude-chat", "docs"]
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "required": ["channel", "pin", "apply", "deletion", "license_change"],
          "properties": {
            "channel": {
              "enum": ["stable", "latest-docs", "manual"]
            },
            "pin": {
              "enum": ["commit-sha", "tag", "documentation-date", "none"]
            },
            "apply": {
              "enum": ["explicit-approval", "manual-review-only", "none"]
            },
            "deletion": {
              "enum": ["separate-explicit-approval", "not-applicable"]
            },
            "license_change": {
              "enum": ["block", "review", "not-applicable"]
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": ["classification_evidence_url", "classification_checked_at", "file_map"],
          "properties": {
            "license_spdx": {
              "type": ["string", "null"]
            },
            "license_url": {
              "type": ["string", "null"]
            },
            "license_sha256": {
              "anyOf": [
                {"$ref": "#/$defs/sha256"},
                {"type": "null"}
              ]
            },
            "notice_path": {
              "type": ["string", "null"]
            },
            "classification_evidence_url": {
              "type": "string"
            },
            "classification_checked_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "file_map": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["upstream_path", "local_path", "treatment"],
                "properties": {
                  "upstream_path": {"type": ["string", "null"]},
                  "local_path": {"type": ["string", "null"]},
                  "treatment": {
                    "enum": ["verbatim", "modified", "excluded", "local-only", "reference-only"]
                  }
                }
              }
            }
          }
        },
        "protection": {
          "type": "object",
          "required": ["protected_globs"],
          "properties": {
            "protected_globs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "validation": {
          "type": "object",
          "required": ["structure_checks", "behavior_fixtures", "codex_smoke_prompts", "claude_smoke_prompts"],
          "properties": {
            "structure_checks": {"type": "array", "items": {"type": "string"}},
            "behavior_fixtures": {"type": "array", "items": {"type": "string"}},
            "codex_smoke_prompts": {"type": "array", "items": {"type": "string"}},
            "claude_smoke_prompts": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
